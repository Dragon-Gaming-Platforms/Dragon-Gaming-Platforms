{
  "id": "./",
  "name": "Dragon Gaming Platforms",
  "short_name": "Dragon Games",
  "description": "Play browser games, run emulators, and use web tools from Dragon Gaming Platforms.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#09090f",
  "theme_color": "#09090f",
  "categories": ["games", "entertainment"],
  "shortcuts": [
    {
      "name": "Browse game library",
      "short_name": "Browse",
      "description": "Open the Dragon Gaming Platforms game library.",
      "url": "./#filterBarRoot",
      "icons": [
        { "src": "./pwa/app-icon-192.png", "sizes": "192x192", "type": "image/png" }
      ]
    },
    {
      "name": "Play a random game",
      "short_name": "Random game",
      "description": "Launch a random browser game.",
      "url": "./?random=1",
      "icons": [
        { "src": "./pwa/app-icon-192.png", "sizes": "192x192", "type": "image/png" }
      ]
    }
  ],
  "icons": [
    {
      "src": "./pwa/app-icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "./pwa/app-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ]
}
